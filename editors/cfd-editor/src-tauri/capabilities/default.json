{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for CFD Editor",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "process:allow-restart",
    "updater:default"
  ]
}
