{
  "namespace": {
    "prefix": "namespace",
    "body": "namespace ${1:name};",
    "description": "Declare this file's namespace."
  },
  "const": {
    "prefix": "const",
    "body": [
      "const ${1:NAME}: ${2:int} = ${3:value};"
    ],
    "description": "Define a compile-time CFT constant."
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant},",
      "}"
    ],
    "description": "Define a CFT enum."
  },
  "flag enum": {
    "prefix": "flag",
    "body": [
      "@flag",
      "enum ${1:Name} {",
      "\t${2:Read} = 1,",
      "\t${3:Write} = 2,",
      "}"
    ],
    "description": "Define a @flag enum."
  },
  "type": {
    "prefix": "type",
    "body": "type ${1:Name} = ${2:string};",
    "description": "Define a type alias."
  },
  "abstract type": {
    "prefix": "abstract",
    "body": [
      "abstract table ${1:Name} {",
      "\t${2:field}: ${3:string};",
      "}"
    ],
    "description": "Define an abstract CFT type."
  },
  "sealed type": {
    "prefix": "sealed",
    "body": [
      "sealed data ${1:Name} {",
      "\t${2:field}: ${3:string};",
      "}"
    ],
    "description": "Define a sealed CFT type."
  },
  "check block": {
    "prefix": "check",
    "body": [
      "check {",
      "\t${1:condition};",
      "}"
    ],
    "description": "Define a check block."
  },
  "localized annotation": {
    "prefix": "@localized",
    "body": [
      "@localized"
    ],
    "description": "Mark a field as language-localized."
  },
  "dimension annotation": {
    "prefix": "@dimension",
    "body": [
      "@dimension(\"${1:name}\")"
    ],
    "description": "Bind a field to a configured dimension."
  },
  "host singleton": {
    "prefix": "@Host",
    "body": [
      "@Host",
      "singleton ${1:HostServices} {",
      "\t${2:call}: fn(${3:value}: ${4:int}) -> ${5:int};",
      "}"
    ],
    "description": "Define a host-provided singleton interface."
  },
  "optional field": {
    "prefix": "option",
    "body": [
      "${1:field}: ${2:string}? = None;"
    ],
    "description": "Define an optional field."
  },
  "function field": {
    "prefix": "fn",
    "body": [
      "${1:field}: fn(${2:value}: ${3:int}) -> ${4:int};"
    ],
    "description": "Define a function-typed field."
  },
  "table": {
    "prefix": "table",
    "body": [
      "table ${1:Name} {",
      "\t${2:field}: ${3:string};",
      "}"
    ],
    "description": "Define a CFT table."
  },
  "singleton": {
    "prefix": "singleton",
    "body": [
      "singleton ${1:Name} {",
      "\t${2:field}: ${3:string};",
      "}"
    ],
    "description": "Define a CFT singleton."
  },
  "data": {
    "prefix": "data",
    "body": [
      "data ${1:Name} {",
      "\t${2:field}: ${3:string};",
      "}"
    ],
    "description": "Define a CFT data."
  },
  "for loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t${3:expression};",
      "}"
    ],
    "description": "Iterate over a collection."
  },
  "if block": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2:expression};",
      "}"
    ],
    "description": "Conditional block."
  },
  "use": {
    "prefix": "use",
    "body": "use ${1:namespace}::${2:Name};",
    "description": "Import a declaration."
  },
  "fstring": {
    "prefix": "fstring",
    "body": "f\"${1:text} {${2:self.name}}\"",
    "description": "Formatted string template."
  }
}
