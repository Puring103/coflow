{
  "const": {
    "prefix": "const",
    "body": ["const ${1:NAME}: ${2:int} = ${3:value};"],
    "description": "Define a compile-time CFT constant."
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:Variant},", "}"],
    "description": "Define a CFT enum."
  },
  "flag enum": {
    "prefix": "flag",
    "body": [
      "@flag",
      "enum ${1:Name} {",
      "\t${2:Read} = 1,",
      "\t${3:Write} = 2,",
      "}"
    ],
    "description": "Define a @flag enum."
  },
  "type": {
    "prefix": "type",
    "body": ["type ${1:Name} = ${2:string};"],
    "description": "Define a CFT type alias."
  },
  "table": {
    "prefix": "table",
    "body": ["table ${1:Name} {", "\t${2:field}: ${3:string};", "}"],
    "description": "Define records with identity."
  },
  "data": {
    "prefix": "data",
    "body": ["data ${1:Name} {", "\t${2:field}: ${3:string};", "}"],
    "description": "Define inline data."
  },
  "singleton": {
    "prefix": "singleton",
    "body": ["singleton ${1:Name} {", "\t${2:field}: ${3:string};", "}"],
    "description": "Define one configuration record."
  },
  "abstract table": {
    "prefix": "abstract",
    "body": ["abstract table ${1:Name} {", "\t${2:field}: ${3:string};", "}"],
    "description": "Define an abstract CFT type."
  },
  "sealed data": {
    "prefix": "sealed",
    "body": ["sealed data ${1:Name} {", "\t${2:field}: ${3:string};", "}"],
    "description": "Define a sealed CFT type."
  },
  "check block": {
    "prefix": "check",
    "body": ["check ${1:RuleName} {", "\t${2:condition};", "}"],
    "description": "Define a named check rule."
  },
  "when block": {
    "prefix": "when",
    "body": ["when ${1:condition} {", "\t${2:condition};", "}"],
    "description": "Define a conditional check block."
  },
  "all quantifier": {
    "prefix": "all",
    "body": ["all ${1:item} in ${2:items} {", "\t${3:condition};", "}"],
    "description": "Define an all quantifier check."
  },
  "any quantifier": {
    "prefix": "any",
    "body": ["any ${1:item} in ${2:items} {", "\t${3:condition};", "}"],
    "description": "Define an any quantifier check."
  },
  "none quantifier": {
    "prefix": "none",
    "body": ["none ${1:item} in ${2:items} {", "\t${3:condition};", "}"],
    "description": "Define a none quantifier check."
  },
  "localized annotation": {
    "prefix": "@localized",
    "body": ["@localized"],
    "description": "Mark a field as language-localized."
  },
  "dimension annotation": {
    "prefix": "@dimension",
    "body": ["@dimension(\"${1:name}\")"],
    "description": "Bind a field to a configured dimension."
  },
  "optional field": {
    "prefix": "option",
    "body": ["${1:field}: Option<${2:string}> = None;"],
    "description": "Define an Option field with a None default."
  }
}
