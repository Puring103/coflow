{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CFT",
  "scopeName": "source.cft",
  "patterns": [
    { "include": "#comments" },
    { "include": "#formatted-strings" },
    { "include": "#strings" },
    { "include": "#module-declarations" },
    { "include": "#declarations" },
    { "include": "#annotations" },
    { "include": "#references" },
    { "include": "#constructors" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#builtin-functions" },
    { "include": "#constants" },
    { "include": "#user-types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": { "patterns": [
      { "name": "comment.line.number-sign.cft", "match": "#.*$" }
    ] },
    "strings": { "patterns": [
      {
        "name": "string.quoted.double.cft",
        "begin": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])\"",
        "end": "\"",
        "patterns": [
          { "name": "constant.character.escape.cft", "match": "\\\\[\"\\\\nrt]" },
          { "name": "invalid.illegal.escape.cft", "match": "\\\\." }
        ]
      }
    ] },
    "formatted-strings": { "patterns": [
      {
        "name": "string.quoted.double.formatted.cft",
        "begin": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(f)(\")",
        "beginCaptures": {
          "1": { "name": "storage.type.string.cft" },
          "2": { "name": "punctuation.definition.string.begin.cft" }
        },
        "end": "\"",
        "endCaptures": { "0": { "name": "punctuation.definition.string.end.cft" } },
        "patterns": [
          { "name": "constant.character.escape.cft", "match": "\\\\[\"\\\\nrt{}]" },
          {
            "name": "meta.interpolation.cft",
            "begin": "(?<!\\{)\\{(?!\\{)",
            "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.cft" } },
            "end": "(?<!\\})\\}(?!\\})",
            "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.cft" } },
            "patterns": [{ "include": "$self" }]
          },
          { "name": "constant.character.escape.cft", "match": "\\{\\{|\\}\\}" },
          { "name": "invalid.illegal.escape.cft", "match": "\\\\." }
        ]
      }
    ] },
    "module-declarations": { "patterns": [
      {
        "name": "meta.namespace.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(namespace)\\s+([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?:::[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)*)",
        "captures": {
          "1": { "name": "keyword.control.namespace.cft" },
          "2": { "name": "entity.name.namespace.cft" }
        }
      },
      {
        "name": "meta.use.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(use)\\s+([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?:::[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)*)(?:\\s+(as)\\s+([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*))?",
        "captures": {
          "1": { "name": "keyword.control.import.cft" },
          "2": { "name": "entity.name.namespace.cft" },
          "3": { "name": "keyword.control.import.as.cft" },
          "4": { "name": "entity.name.type.alias.cft" }
        }
      }
    ] },
    "annotations": { "patterns": [
      {
        "name": "storage.modifier.annotation.cft",
        "match": "@(struct|flag|expand|idAsEnum|localized|singleton|Host|dimension|label|description)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
      },
      {
        "name": "invalid.illegal.annotation.cft",
        "match": "@[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*"
      }
    ] },
    "declarations": { "patterns": [
      {
        "name": "meta.declaration.const.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(const)\\s+([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)",
        "captures": { "1": { "name": "storage.type.const.cft" }, "2": { "name": "entity.name.constant.cft" } }
      },
      {
        "name": "meta.declaration.enum.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(enum)\\s+([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)",
        "captures": { "1": { "name": "storage.type.enum.cft" }, "2": { "name": "entity.name.type.enum.cft" } }
      },
      {
        "name": "meta.declaration.type.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])((?:(?:abstract|sealed)\\s+)*)(type)\\s+([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)",
        "captures": { "1": { "name": "storage.modifier.cft" }, "2": { "name": "storage.type.cft" }, "3": { "name": "entity.name.type.cft" } }
      }
    ] },
    "references": { "patterns": [
      {
        "name": "constant.other.reference.direct.cft",
        "match": "&[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?:::[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)*"
      },
      {
        "name": "constant.other.qualified.cft",
        "match": "[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?:::[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)+"
      }
    ] },
    "constructors": { "patterns": [
      {
        "name": "support.function.constructor.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(Some|Ok|Err)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(?=\\s*\\()"
      }
    ] },
    "builtin-functions": { "patterns": [
      {
        "name": "support.function.builtin.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(len|contains|isUnique|min|max|sum|keys|values|matches|records|alert)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(?=\\s*\\()"
      }
    ] },
    "builtin-types": { "patterns": [
      {
        "name": "storage.type.primitive.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(int|float|bool|string|Option|Result|fn)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
      }
    ] },
    "constants": { "patterns": [
      {
        "name": "constant.language.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(true|false|None)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
      },
      {
        "name": "invalid.deprecated.null.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])null(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
      }
    ] },
    "keywords": { "patterns": [
      {
        "name": "keyword.control.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(namespace|use|as|check|when|all|any|none|in|is)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
      },
      {
        "name": "storage.modifier.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(abstract|sealed)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
      },
      {
        "name": "storage.type.cft",
        "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(const|enum|type)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
      }
    ] },
    "numbers": { "patterns": [
      { "name": "constant.numeric.float.cft", "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)[fF]?(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])" },
      { "name": "constant.numeric.integer.cft", "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])[0-9]+(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])" }
    ] },
    "user-types": { "patterns": [
      {
        "name": "support.type.user-defined.cft",
        "match": "[_\\p{Lu}\\p{Lt}\\p{Lo}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*"
      }
    ] },
    "operators": { "patterns": [
      { "name": "keyword.operator.cft", "match": "::|->|==|!=|<=|>=|<<|>>|&&|\\|\\||//|\\*\\*|[+\\-*/%<>=!~&|^?:.]" }
    ] },
    "punctuation": { "patterns": [
      { "name": "punctuation.separator.cft", "match": "[;,]" },
      { "name": "punctuation.section.cft", "match": "[{}\\[\\]()]" }
    ] }
  }
}
