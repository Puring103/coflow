{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CFD",
  "scopeName": "source.cfd",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#function"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#references"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#record-colon"
    },
    {
      "include": "#type-before-brace"
    },
    {
      "include": "#field-name"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#user-types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.cfd",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.template.cfd",
          "begin": "(?<![\\w])f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cfd",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.cfd",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cfd",
              "match": "\\\\[\"\\\\nrt]"
            },
            {
              "name": "invalid.illegal.escape.cfd",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "function": {
      "patterns": [
        {
          "name": "meta.function.anonymous.cfd",
          "begin": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(fn)(?=\\s*\\()",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.cfd"
            }
          },
          "end": "(?<=\\})",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#function"
            },
            {
              "include": "#function-parameters"
            },
            {
              "include": "#function-keywords"
            },
            {
              "include": "#constructors"
            },
            {
              "include": "#builtin-types"
            },
            {
              "include": "#builtin-functions"
            },
            {
              "include": "#references"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#function-block"
            },
            {
              "include": "#punctuation"
            },
            {
              "include": "#user-types"
            }
          ]
        }
      ]
    },
    "function-block": {
      "patterns": [
        {
          "name": "meta.block.cfd",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.begin.cfd"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.cfd"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#function"
            },
            {
              "include": "#function-keywords"
            },
            {
              "include": "#constructors"
            },
            {
              "include": "#builtin-types"
            },
            {
              "include": "#builtin-functions"
            },
            {
              "include": "#references"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#function-block"
            },
            {
              "include": "#punctuation"
            },
            {
              "include": "#user-types"
            }
          ]
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "name": "variable.parameter.function.cfd",
          "match": "[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?=\\s*:)"
        }
      ]
    },
    "function-keywords": {
      "patterns": [
        {
          "name": "keyword.control.cfd",
          "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(fn|var|return|if|else|for|while|build|as|break|continue|in|is)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "name": "support.function.constructor.cfd",
          "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(Some)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(?=\\s*\\()"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.cfd",
          "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(int|float|bool|string|fstring|fn)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.cfd",
          "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(int|float|len|contains|isUnique|min|max|sum|keys|values|matches|map|filter|fold|any|all)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(?=\\s*\\()"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "constant.other.reference.cfd",
          "match": "&[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?:::[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)*"
        }
      ]
    },
    "record-colon": {
      "patterns": [
        {
          "name": "meta.record.cfd",
          "match": "^(\\s*)([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)\\s*(:)\\s*([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?:::[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)*)(?=\\s*\\{)",
          "captures": {
            "2": {
              "name": "entity.name.tag.cfd"
            },
            "3": {
              "name": "punctuation.separator.key-value.cfd"
            },
            "4": {
              "name": "entity.name.type.cfd"
            }
          }
        }
      ]
    },
    "type-before-brace": {
      "patterns": [
        {
          "match": "([_\\p{Lu}\\p{Lt}\\p{Lo}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*(?:::[_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)*)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "entity.name.type.cfd"
            }
          }
        }
      ]
    },
    "field-name": {
      "patterns": [
        {
          "match": "([_\\p{L}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.cfd"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.cfd",
          "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(None|true|false)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
        },
        {
          "name": "invalid.deprecated.null.cfd",
          "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])null(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cfd",
          "match": "(?<![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|[0-9]+)(?![_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}])"
        }
      ]
    },
    "user-types": {
      "patterns": [
        {
          "name": "support.type.user-defined.cfd",
          "match": "[_\\p{Lu}\\p{Lt}\\p{Lo}\\p{Nl}][_\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cfd",
          "match": "\\.\\.=|::|->|=>|\\.\\.|==|!=|<=|>=|<<|>>|&&|\\|\\||//|\\*\\*|\\+=|-=|\\*=|/=|[+\\-*/%<>=!~&|^?.]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.cfd",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.cfd",
          "match": "[\\[\\]()]"
        },
        {
          "name": "punctuation.separator.cfd",
          "match": "[,;]"
        },
        {
          "name": "punctuation.separator.key-value.cfd",
          "match": ":"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "keyword.control.import.cfd",
          "match": "\\buse\\b"
        }
      ]
    }
  }
}
