{
  "Top-level record": {
    "prefix": "rec",
    "body": [
      "${1:key}: ${2:TypeName} {",
      "\t${3:field}: ${4:value}",
      "}"
    ],
    "description": "Top-level CFD record."
  },
  "Direct reference": {
    "prefix": "&ref",
    "body": "&${1:Type}::${2:key}",
    "description": "Explicitly typed record reference: &Type::key"
  },
  "Array": {
    "prefix": "arr",
    "body": "[${1:item1}, ${2:item2}]",
    "description": "CFD array value."
  },
  "Some": {
    "prefix": "Some",
    "body": "Some(${1:value})",
    "description": "Present optional value."
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn(${1:value}: ${2:int}) -> ${3:int} {",
      "\t${4:value}",
      "}"
    ],
    "description": "CFD function value."
  },
  "Inline data": {
    "prefix": "data",
    "body": "${1:DataName} { ${2:field}: ${3:value} }",
    "description": "Typed inline data value."
  },
  "use": {
    "prefix": "use",
    "body": "use ${1:namespace}::${2:Name};",
    "description": "Import a declaration."
  },
  "fstring": {
    "prefix": "fstring",
    "body": "f\"${1:text} {${2:self.name}}\"",
    "description": "Formatted string template."
  }
}
