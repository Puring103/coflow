enum CharacterId {}
enum Mood { Calm, Happy }

@struct
sealed data Stats {
  health: int;
  weights: [float] = [];
  bonus: int?;
}

@idAsEnum(CharacterId)
table Character {
  name: string;
  stats: Stats;
  friend: Character? = None;
  labels: {bool: string} = {};
  moods: {Mood: string} = {};
  mood: Mood?;
  extra: Stats?;
  notes: [string]?;
  callback: (fn() -> int)?;
  text: fstring = f"{self.name}";
  score: fn(bonus: int) -> int => { return self.stats.health + bonus; };
  recordIdentity: fn(value: Character) -> Character => { value };
  callbacks: fn(values: [fn() -> int]) -> [fn() -> int] => { values };
  templateIdentity: fn(value: fstring) -> fstring => { value };
  roundtrip: fn(value: Stats) -> Stats => { value };
  closure: fn(seed: int) -> fn() -> int => { fn() -> int { seed + self.stats.health } };
  check Healthy { Coflow::Check::require(self.stats.health > 0, "health must be positive"); }
}

table Hero : Character {
  level: int = 1;
}

table LocalizedText {
  @localized
  value: string;
  @localized
  optional: string?;
}
