+pub fn parse_cfd_value(source: &str) -> Result<CfdValue, CfdSyntaxDiagnostic> {
+    parse_cfd_value_with_options(source, CfdParseOptions::default())
+}
+
+/// 使用指定结构预算解析一个完整 CFD 值。
+///
+/// # Errors
