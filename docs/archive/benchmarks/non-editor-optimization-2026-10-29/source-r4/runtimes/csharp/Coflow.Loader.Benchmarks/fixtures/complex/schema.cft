data Payload { amount: int; text: string; }
table Row {
  value: int;
  name: string;
  items: [int];
  lookup: {string: int};
  payload: Payload;
  next: Option<&Row> = None;
  label: string;
  note: Option<string> = None;
  f8: int;
  f9: int;
  f10: int;
  f11: int;
  f12: int;
  f13: int;
  f14: int;
  f15: int;
  f16: int;
  f17: int;
  f18: int;
  f19: int;
}
