namespace integration::runtime;

use integration::domain::Character;
use integration::domain::CharacterId;
use integration::domain::Stats;
use integration::domain::ScenarioConfig;

Scenario {
  fullRoundTrip {
    hero: &Character::arcanist,
    config: ScenarioConfig {
      label: "higher-order",
      samples: [2, 4, 6],
      checkpoints: {
        "start": Stats {
          health: 100,
          attack: 10,
          resistances: { "fire": 1 },
        },
        "finish": Stats {
          health: 60,
          attack: 25,
          resistances: { "ice": 5 },
        },
      },
      optionalBonus: Some(Stats {
        health: 3,
        attack: 5,
        resistances: { "arcane": 11 },
      }),
      validation: Ok(Some(Stats {
        health: 1,
        attack: 2,
        resistances: {},
      })),
    },
    stages: [
      fn(value: int) -> int { value + 3 },
      fn(value: int) -> int { value * 2 },
    ],

    execute: fn(value: int) -> int {
      &HostServices.trace(&HostServices.decorate(config.label));
      var stageTotal = stages.map(fn(stage: fn(int) -> int) -> int {
        stage(value)
      }).sum();
      var sampleTotal = config.samples.map(fn(sample: int) -> int {
        sample + hero.stats.attack
      }).sum();
      stageTotal + sampleTotal
    },

    callHost: fn(value: int) -> int {
      &HostServices.adjust(value, fn(item: int) -> int {
        match hero.attributes["rarity"] {
          Some(rarity) => item * rarity,
          None => 0,
        }
      })
    },

    makeScaler: fn(scale: int) -> fn(int) -> int {
      fn(value: int) -> int {
        value * scale + hero.stats.attack
      }
    },

    apply: fn(value: int, operation: fn(int) -> int) -> int {
      match config.checkpoints["finish"] {
        Some(checkpoint) => operation(value) + checkpoint.attack,
        None => operation(value),
      }
    },

    compose: fn(first: fn(int) -> int, second: fn(int) -> int) -> fn(int) -> int {
      fn(value: int) -> int {
        second(first(value))
      }
    },

    integerLoop: fn(iterations: int) -> int {
      var current = 0;
      var total = 0;
      while current < iterations {
        total += current;
        current += 1;
      }
      total
    },

    floatLoop: fn(iterations: int) -> float {
      var current = 0;
      var total = 0.0;
      while current < iterations {
        total += 0.5;
        current += 1;
      }
      total
    },

    numericConversions: fn(value: int, ratio: float) -> int {
      if float(value) < ratio { int(ratio) } else { value }
    },

    enumRoundTrip: fn(value: CharacterId) -> bool {
      value == CharacterId::arcanist
    },

    increment: fn(value: int) -> int {
      value + 1
    },

    directCallChain: fn(value: int) -> int {
      increment(increment(increment(increment(value))))
    },

    tailRecursion: fn(iterations: int) -> int {
      if iterations <= 0 {
        0
      } else {
        tailRecursion(iterations - 1)
      }
    },

    tailAccumulator: fn(iterations: int, total: int) -> int {
      if iterations <= 0 {
        total
      } else {
        tailAccumulator(iterations - 1, total + iterations)
      }
    },

    fieldReadLoop: fn(iterations: int) -> int {
      var current = 0;
      var total = 0;
      while current < iterations {
        total += hero.stats.attack;
        current += 1;
      }
      total
    },

    collectionPipeline: fn(value: int) -> int {
      config.samples
        .map(fn(item: int) -> int { item + value })
        .filter(fn(item: int) -> bool { item % 2 == 0 })
        .fold(0, fn(total: int, item: int) -> int { total + item })
    },

    hostCall: fn(value: int) -> int {
      &HostServices.trace("benchmark");
      value
    },

    hostComposite: fn(value: Option<int>) -> Result<int, string> {
      &HostServices.normalize(value)
    },

    propagateOption: fn(value: Option<int>) -> Option<int> {
      Some(value? + 1)
    },

    propagateResult: fn(value: Result<int, string>) -> Result<int, string> {
      Ok(value? + 1)
    },

    propagateNested: fn(value: Result<Result<int, string>, string>) -> Result<int, string> {
      Ok(value?? + 1)
    },

    makeOptionalAdder: fn(value: Option<int>) -> fn(int) -> int {
      fn(input: int) -> int {
        match value {
          Some(offset) => input + offset,
          None => input,
        }
      }
    },

    collectionQueries: fn(value: int) -> int {
      var found = config.samples.find(fn(item: int) -> bool { item == value });
      var foundValue = match found { Some(item) => item, None => 0 };
      var hasLarger = config.samples.any(fn(item: int) -> bool { item > value });
      var allPositive = config.samples.all(fn(item: int) -> bool { item > 0 });
      var anyValue = if hasLarger { 10 } else { 0 };
      var allValue = if allPositive { 100 } else { 0 };
      foundValue + anyValue + allValue
    },

    emptyCollectionQueries: fn() -> int {
      var empty = config.samples.filter(fn(item: int) -> bool { false });
      var mapped = empty.map(fn(item: int) -> int { item + 1 });
      var folded = empty.fold(7, fn(total: int, item: int) -> int { total + item });
      var found = empty.find(fn(item: int) -> bool { true });
      var foundValue = match found { Some(item) => item, None => 0 };
      var anyValue = if empty.any(fn(item: int) -> bool { true }) { 10 } else { 0 };
      var allValue = if empty.all(fn(item: int) -> bool { false }) { 100 } else { 0 };
      mapped.sum() + folded + foundValue + anyValue + allValue
    },

    makeStats: fn(value: int) -> Stats {
      Stats { health: value, attack: value + 1, resistances: { "typed": value + 2 } }
    },

    makeDefaultStats: fn(value: int) -> Stats {
      Stats { health: value, attack: value + 1 }
    },

    formatValues: fn(value: int, ratio: float, enabled: bool, optional: Option<int>) -> string {
      "value={value}, ratio={ratio}, enabled={enabled}, optional={optional}, stats={config.optionalBonus}"
    },

    syntaxControlFlow: fn(input: int) -> int {
      var total = 0;
      for item, index in [1, 2, 3, 4, 5] {
        if item == 2 { continue; };
        if item == 5 { break; };
        total += item + index;
      }
      for key, item in { "a": 2, "bb": 3 } {
        total += key.len() + item;
      }
      for item in 1..4 {
        total += item;
      }
      for item, index in 1..=3 {
        total += item + index;
      }
      var counter = 0;
      while true {
        counter += 1;
        if counter == 2 { break; }
      }
      total += counter;
      total -= 1;
      total *= 2;
      total /= 2;
      total = total + input;
      total
    },

    syntaxOperators: fn(left: int, right: int, text: string) -> bool {
      -left == -8 &&
      -float(left) == -8.0 &&
      ~left == -9 &&
      left + right == 11 &&
      left - right == 5 &&
      left * right == 24 &&
      left / right == 2 &&
      left // right == 2 &&
      left % right == 2 &&
      right ** 2 == 9 &&
      left << 1 == 16 &&
      left >> 1 == 4 &&
      (left & right) == 0 &&
      (left ^ right) == 11 &&
      (left | right) == 11 &&
      0 < right < left &&
      left >= right &&
      left != right &&
      !(left == right) &&
      ((left > right && right > 0) || left < right) &&
      float(left) / float(right) > 2.5 &&
      float(left) + float(right) == 11.0 &&
      float(left) - float(right) == 5.0 &&
      float(left) * float(right) == 24.0 &&
      float(right) ** 2.0 == 9.0 &&
      float(right) < float(left) &&
      float(right) <= float(left) &&
      float(left) >= float(right) &&
      text + "b" == "ab" &&
      text < "b" &&
      text <= "a" &&
      "z" > text &&
      "a" >= text
    },

    syntaxMatch: fn(value: int, optional: Option<int>, outcome: Result<int, string>, character: CharacterId) -> int {
      var literal = match value { -1 => 1, 0 => 2, _ => 3 };
      var optionValue = match optional { Some(item) => item, None => 0 };
      var resultValue = match outcome { Ok(item) => item, Err(message) => message.len() };
      var enumValue = match character {
        CharacterId::arcanist => 10,
        CharacterId::guardian => 20,
      };
      var boolValue = match value > 0 { true => 1, false => 0 };
      literal + optionValue + resultValue + enumValue + boolValue
    },

    typeMetadata: fn() -> string {
      var identity = if hero is Character { hero.$id } else { "invalid" };
      var matched = match hero {
        Character character => character.$path,
        _ => "invalid",
      };
      "{$type}|{$field}|{$function}|{$id}|{$path}|{identity}|{matched}"
    },

    builtinSyntax: fn(text: string) -> bool {
      var numbers = [1, 2, 3];
      var dictionary = { "a": 1, "b": 2 };
      var emptyNumbers: [int] = [];
      var emptyDictionary: {string: int} = {};
      text.len() == 3 &&
      text.contains("b") &&
      text.startsWith("a") &&
      text.endsWith("c") &&
      !text.isBlank() &&
      text.matches("^a.*c$") &&
      numbers.len() == 3 &&
      numbers.contains(2) &&
      numbers.isUnique() &&
      numbers.min() == 1 &&
      numbers.max() == 3 &&
      numbers.sum() == 6 &&
      numbers.isSorted() &&
      numbers.isStrictlySorted() &&
      numbers.intersects([3, 4]) &&
      numbers.isDisjoint([4, 5]) &&
      numbers.isSubsetOf([0, 1, 2, 3]) &&
      numbers.isSupersetOf([1, 2]) &&
      dictionary.len() == 2 &&
      dictionary.containsKey("a") &&
      dictionary.contains("b") &&
      dictionary.containsValue(2) &&
      dictionary.keys().len() == 2 &&
      dictionary.values().sum() == 3 &&
      emptyNumbers.len() == 0 &&
      emptyDictionary.len() == 0 &&
      (-4).abs() == 4 &&
      (-4.0).abs() == 4.0 &&
      9.0.sqrt() == 3.0 &&
      9.0.isFinite() &&
      1.0.approxEqual(1.001, 0.01)
    },

    formatSyntax: fn(text: string) -> string {
      "literal={{ok}} text={text} owner={$path} hero={hero.$path} config={config.optionalBonus}"
    },

    primeSum: fn(limit: int) -> int {
      var total = 0;
      for candidate in 2..=limit {
        var prime = true;
        for divisor in 2..candidate {
          if candidate % divisor == 0 {
            prime = false;
            break;
          }
        }
        if prime { total += candidate; }
      }
      total
    },

    matrixKernel: fn(size: int) -> int {
      var total = 0;
      for row in 0..size {
        for column in 0..size {
          for depth in 0..size {
            total += (row + 1) * (column + 1) + depth % 3;
          }
        }
      }
      total
    },

    fibonacci: fn(value: int) -> int {
      if value <= 1 { value } else { fibonacci(value - 1) + fibonacci(value - 2) }
    },
  }
}
