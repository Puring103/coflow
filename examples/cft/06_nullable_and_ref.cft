# Optional fields use Option<T> with None or Some(value).
# Record reference fields use &Type; data files write &key values.

type ExampleQuestStep {
  title: string;
  optional_target: Option<&ExampleItem> = None;

  required_item: &ExampleItem;

  check {
    title != "";
    required_item.id != "";

  }
}

type ExampleQuest {
  name: string;
  steps: [ExampleQuestStep] = [];
  reward: &ExampleReward;

  check {
    id != "";
    name != "";
    steps.len() > 0;
    reward is ExampleReward;
  }
}
