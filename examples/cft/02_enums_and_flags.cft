# Plain enums model a finite set of named integer values. `@label` is the
# editor-facing alias, while `@description` becomes C# XML documentation.

@label("物品稀有度")
@description("决定物品品质层级。")
enum ExampleRarity {
  @label("普通")
  Common = 0,
  @label("稀有")
  Rare = 10,
  @label("史诗")
  @description("较高品质的物品。")
  Epic = 20,
}

@label("伤害类型")
enum ExampleDamageType {
  @label("物理")
  Physical,
  @label("火焰")
  Fire,
  @label("冰霜")
  Ice,
}

# @flag enums support bitwise checks.

@flag
@label("权限")
enum ExamplePermission {
  @label("读取")
  Read = 1,
  @label("写入")
  Write = 2,
  @label("执行")
  Execute = 4,
}

@label("枚举使用示例")
@description("演示字段别名不会改变 CFD 中的稳定字段名。")
type ExampleEnumUsage {
  @label("稀有度")
  @description("物品的品质层级。")
  rarity: ExampleRarity = ExampleRarity.Common;
  @label("伤害属性")
  damage_type: ExampleDamageType = ExampleDamageType.Fire;
  @label("可用权限")
  permissions: ExamplePermission = ExamplePermission.Read;

  check {
    rarity >= ExampleRarity.Common;
    damage_type != ExampleDamageType.Physical;
    (permissions & ExamplePermission.Read) != ExamplePermission(0);
  }
}
