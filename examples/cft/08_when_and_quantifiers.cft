# when blocks are conditional checks.
# all, any, and none iterate over arrays or dicts.

type ExampleSkill {
  name: string;
  is_passive: bool;
  cooldown: Option<float> = None;
  range: Option<float> = None;
  costs: [int] = [];

  check {
    id != "";
    name != "";

    when !is_passive {
      costs.len() > 0;
    }

    when is_passive {
      costs.len() == 0;
    }

    all cost in costs {
      cost >= 0;
    }

    any cost in costs {
      cost == 0;
    }

    none cost in costs {
      cost < 0;
    }
  }
}
