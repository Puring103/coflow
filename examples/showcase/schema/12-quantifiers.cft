# Feature: collection predicates.

table QuantifierRule {
  numbers: [int];

  check {
    Coflow::Check::require(self.numbers.all(fn(value: int) -> bool { value >= 0 }), "numbers must be nonnegative");
    Coflow::Check::require(self.numbers.any(fn(value: int) -> bool { value == 0 }), "numbers must contain zero");
    Coflow::Check::require(!self.numbers.any(fn(value: int) -> bool { value < 0 }), "numbers must not contain negatives");
  }
}
