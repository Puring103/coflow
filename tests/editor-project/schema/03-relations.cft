abstract data Effect {
  label: string;
  duration: float? = None;
}

sealed data DamageEffect : Effect {
  element: Element;
  amount: int;
}

sealed data HealEffect : Effect {
  amount: int;
}

sealed data CompositeEffect : Effect {
  effects: [Effect];
}

@idAsEnum(EntityId)
table Entity {
  @label("显示名称")
  name: string;

  level: int = DEFAULT_LEVEL;
  rarity: Rarity = Common;
  tags: [string] = DEFAULT_TAGS;

  stats: Stats = Stats {};

  primaryEffect: Effect;
  alternateEffects: [Effect] = [];
  parent: Entity? = None;
  related: [Entity] = [];

  check {
    Coflow::Check::require(self.level > 0, f"实体 {self.id} 的等级必须大于 0");
    Coflow::Check::require(!self.name.isBlank(), "实体名称不能为空");
    Coflow::Check::require(self.tags.isUnique(), "实体标签必须唯一");
    for effect in self.alternateEffects {
      Coflow::Check::require(!effect.label.isBlank(), "效果名称不能为空");
    }
  }
}

data RewardEntry {
  reward: Entity;
  count: int;
}

data QuestStep {
  title: string;
  targets: [Entity];
  rewards: [RewardEntry];
  next: Quest? = None;
}

table Quest {
  displayId: Identifier;
  title: string;
  prerequisite: Quest? = None;
  steps: [QuestStep];
  rewardGroups: {string: [RewardEntry]} = {};

  check {
    Coflow::Check::require(!self.displayId.isBlank(), "任务标识不能为空");
    Coflow::Check::require(self.steps.len() > 0, "任务需要步骤");
    for index, step in self.steps {
      Coflow::Check::require(!step.title.isBlank(), f"第 {index} 个步骤缺少标题");
      Coflow::Check::require(step.targets.len() > 0, "步骤需要目标");
      for reward in step.rewards {
        Coflow::Check::require(reward.count > 0, "奖励数量必须为正");
      }
    }
  }
}

check EntityCatalog {
  Coflow::Check::require(Coflow::Check::records(Entity).len() >= 3, "实体目录至少需要三项");
  Coflow::Check::require(Coflow::Check::records(Entity).any(fn(entity: Entity) -> bool { entity.rarity == Rarity::Epic }), "实体目录需要 Epic 实体");
}
