abstract data Effect {
  label: string;
  duration: float? = None;
}

sealed data DamageEffect : Effect {
  element: Element;
  amount: int;
}

sealed data HealEffect : Effect {
  amount: int;
}

sealed data CompositeEffect : Effect {
  effects: [Effect];
}

@idAsEnum(EntityId)
table Entity {
  @label("显示名称")
  name: string;

  level: int = DEFAULT_LEVEL;
  rarity: Rarity = Common;
  tags: [string] = DEFAULT_TAGS;

  @expand
  stats: Stats = Stats {};

  primaryEffect: Effect;
  alternateEffects: [Effect] = [];
  parent: Entity? = None;
  related: [Entity] = [];

  check {
    level > 0: "实体 {id} 的等级必须大于 0";
    name.isBlank() == false;
    tags.isUnique();
    all effect in alternateEffects {
      effect.label.isBlank() == false;
    }
  }
}

data RewardEntry {
  reward: Entity;
  count: int;
}

data QuestStep {
  title: string;
  targets: [Entity];
  rewards: [RewardEntry];
  next: Quest? = None;
}

table Quest {
  displayId: Identifier;
  title: string;
  prerequisite: Quest? = None;
  steps: [QuestStep];
  rewardGroups: {string: [RewardEntry]} = {};

  check {
    displayId.isBlank() == false;
    steps.len() > 0;
    all step, index in steps {
      step.title.isBlank() == false: "第 {index} 个步骤缺少标题";
      step.targets.len() > 0;
      all reward in step.rewards {
        reward.count > 0;
      }
    }
  }
}

check EntityCatalog {
  records(Entity).len() >= 3;
  any entity in records(Entity) {
    entity.rarity == Rarity::Epic;
  }
}
