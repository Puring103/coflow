@struct
sealed type Vector2 {
  x: float = 0.0;
  y: float = 0.0;
}

@struct
sealed type Stats {
  health: int = 100;
  speed: float = 1.0;
  resistances: {Element: float} = {};
}

@label("基础字段集合")
@description("用于验证每一种字段编辑器及其空值、默认值和复杂集合状态。")
type ValueGallery {
  integerValue: int;
  floatValue: float;
  booleanValue: bool;
  shortText: string;
  longText: string;
  rarity: Rarity = Common;
  features: Feature = Feature::Tradable | Feature::Stackable;
  optionalText: Option<string> = None;
  optionalNumber: Option<int> = None;
  numbers: [int] = [];
  labels: {string: string} = {};
  position: Vector2 = Vector2 { x: 0.0, y: 0.0 };
  stats: Stats = Stats {};
  matrix: [[int]] = [];
  nestedLookup: {string: [Stats]} = {};
}
