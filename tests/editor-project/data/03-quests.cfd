introduction: Quest {
  displayId: "quest_intro",
  title: "First steps",
  steps: [
    QuestStep {
      title: "Meet the party",
      targets: [&Entity::warrior, &Entity::mage],
      rewards: [RewardEntry { reward: &Entity::chest, count: 1 }],
    },
  ],
  rewardGroups: {
    "completion": [RewardEntry { reward: &Entity::chest, count: 1 }],
    "optional": [],
  },
}

advanced: Quest {
  displayId: "quest_advanced",
  title: "Nested collections",
  prerequisite: &advanced,
  steps: [
    QuestStep {
      title: "Defeat targets",
      targets: [&Entity::root, &Entity::mage],
      rewards: [
        RewardEntry { reward: &Entity::chest, count: 2 },
        RewardEntry { reward: &Entity::warrior, count: 1 },
      ],
    },
  ],
}
