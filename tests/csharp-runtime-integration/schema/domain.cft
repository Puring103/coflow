enum CharacterId {}
enum Mood { Calm, Happy }

@struct
sealed data Stats {
  health: int;
  weights: [float] = [];
  bonus: int?;
}

@idAsEnum(CharacterId)
table Character {
  name: string;
  stats: Stats;
  friend: Character? = None;
  labels: {bool: string} = {};
  moods: {Mood: string} = {};
  mood: Mood?;
  extra: Stats?;
  notes: [string]?;
  callback: (fn() -> int)?;
  text: fstring = f"{self.name}";
  score: fn(bonus: int) -> int => { return self.stats.health + bonus; };
  check Healthy { Coflow::Check::require(self.stats.health > 0, "health must be positive"); }
}

table Hero : Character {
  level: int = 1;
}
