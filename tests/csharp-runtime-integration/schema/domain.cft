enum CharacterId {}

enum CharacterClass {
  Guardian,
  Arcanist,
}

@flag
enum CharacterTrait {
  Empty = 0,
  Durable = 1,
  Ranged = 2,
  Magical = 4,
}

@struct
sealed type Stats {
  health: int;
  attack: int;
  resistances: {string: int} = {};
}

@struct
sealed type ScenarioConfig {
  label: string;
  samples: [int];
  checkpoints: {string: Stats};
  optionalBonus: Option<Stats>;
  validation: Result<Option<Stats>, string>;
}

abstract type Ability {
  label: string;
}

sealed type DamageAbility : Ability {
  damage: int;
}

sealed type HealAbility : Ability {
  healing: int;
}

@idAsEnum(CharacterId)
type Character {
  name: string;
  class: CharacterClass;
  traits: CharacterTrait = CharacterTrait::Empty;
  enabled: bool = true;
  stats: Stats;
  tags: [string];
  attributes: {string: int};
  primaryAbility: Ability;
  abilities: [Ability] = [];
  status: Result<int, string> = Ok(0);
  fallback: Option<&Character> = None;
}

@singleton
type RuntimeSettings {
  environment: string;
  retries: int = 3;
}
