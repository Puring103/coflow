<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tests/integration/generated/**/*.cs"
             Link="Generated/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../tests/integration/generated/coflow.contract"
             Link="coflow.contract"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../tests/integration/data/*.cfd"
             Link="Data/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Coflow.Runtime/Coflow.Runtime.csproj" />
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
</Project>
