singleton RuntimeSettings {
  enabled: bool = true;
}

@Host
singleton HostServices {
  environment: string;
  favorite: Character?;
  mood: Mood;
  log: fn(message: string) -> ();
  echoStats: fn(value: Stats) -> Stats;
  echoProfile: fn(value: Profile) -> Profile;
  echoCharacter: fn(value: Character) -> Character;
}
